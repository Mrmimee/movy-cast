{
  "manifest_version": 3,
  "name": "Movy Cast",
  "version": "1.0.0",
  "key": "",
  "description": "极简 movy.sx 电视投屏（DLNA）、音画/字幕同步与中文字幕搜索插件",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Movy Cast",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "webRequest",
    "storage",
    "tabs",
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://www.movy.sx/*",
    "https://movy.sx/*",
    "http://127.0.0.1:18923/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.movy.sx/*",
        "https://movy.sx/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "player-ui.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
